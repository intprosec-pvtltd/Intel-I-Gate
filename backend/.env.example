CAMERA_ALLOW_CIDRS=192.168.0.3/32,192.168.0.7/32
CAMERA_PORTS=554,8554,8080
AI_ENABLED=true
DEVICE=cuda:0
DINO_DEVICE=cuda:0
INFERENCE_FPS=5
PREVIEW_FPS=15
DINO_INTERVAL=3
BIOMETRIC_ENABLED=true
FACE_MATCH_THRESHOLD=0.55
AUTO_EXIT_ENABLED=true
AUTO_TEST_EXIT_ENABLED=true
AUTO_EXIT_THRESHOLD=0.65
AUTO_EXIT_MARGIN=0.10
AUTO_EXIT_CONFIRMATIONS=3
AUTO_EXIT_MIN_SPAN=1
AUTO_EXIT_WINDOW=10
AUTO_EXIT_MIN_ENTRY_SECONDS=15
AUTO_EXIT_MAX_FRAME_AGE=3
AUTO_EXIT_FAST_ENABLED=true
AUTO_EXIT_FAST_THRESHOLD=0.85
AUTO_EXIT_FAST_MARGIN=0.20
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=YOUR_TWILIO_PHONE_NUMBER
TWILIO_MESSAGING_SERVICE_SID=
OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RECIPIENT_HOURLY_LIMIT=5
OTP_GUARD_HOURLY_LIMIT=30
MAINTENANCE_INTERVAL_SECONDS=30
VISIT_RESPONSE_HOURS=24
PUBLIC_APP_URL=
CALENDAR_CLEANUP_ENABLED=false
ORPHAN_GRACE_MINUTES=10
RETENTION_DAYS=30
TEMPORARY_HOURS=24
RESIDENT_RECOGNITION_ENABLED=true
RESIDENT_MATCH_THRESHOLD=0.85
RESIDENT_MATCH_MARGIN=0.20
